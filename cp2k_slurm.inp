&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME h2o_slurm_test
  RUN_TYPE ENERGY_FORCE
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS FALSE
    MULTIPLICITY 1
    CHARGE 0
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &SCF
      MAX_SCF 100
      EPS_SCF 1e-06
      SCF_GUESS ATOMIC
      ADDED_MOS 20
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &PBE ON
        &END PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 12.0 0.0 0.0
      B 0.0 12.0 0.0
      C 0.0 0.0 12.0
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME h2o.xyz
      COORD_FILE_FORMAT xyz
    &END TOPOLOGY
    &KIND O
      POTENTIAL GTH-PBE-q6
      BASIS_SET DZVP-MOLOPT-SR-GTH
    &END KIND
    &KIND H
      POTENTIAL GTH-PBE-q1
      BASIS_SET DZVP-MOLOPT-SR-GTH
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
