&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME pva_borate_energy
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &SCF
      MAX_SCF 50
      EPS_SCF 1e-06
      SCF_GUESS ATOMIC
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBUFFER 8
      &END MIXING
    &END SCF
    &MGRID
      NGRIDS 4
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &XC
      &XC_FUNCTIONAL
        &PBE
          SCALE_X 1.0
          SCALE_C 1.0
        &END PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 12.0 0.0 0.0
      B 0.0 12.0 0.0
      C 0.0 0.0 12.0
      PERIODIC NONE
    &END CELL
    &COORD
      O  6.0  6.0  6.0
    &END COORD
    &KIND O
      POTENTIAL GTH-PBE-q6
      BASIS_SET DZVP-MOLOPT-SR-GTH
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
