&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME minimal_combined
  RUN_TYPE GEO_OPT
&END GLOBAL
&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    OPTIMIZER BFGS
    MAX_ITER 200
    &BFGS
      TRUST_RADIUS 0.25
    &END BFGS
  &END GEO_OPT
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &SCF
      MAX_SCF 50
      EPS_SCF 1e-06
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &MGRID
      CUTOFF 300
      REL_CUTOFF 50
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 12.0 0 0
      B 0 12.0 0
      C 0 0 12.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Ti 0.0 0.0 0.0
      Ti 3.0 0.0 0.0
      Ti 6.0 0.0 0.0
      C 1.5 0.0 -1.0
      C 4.5 0.0 -1.0
      O 0.0 0.0 1.5
      O 6.0 0.0 1.5
      H 0.0 0.0 2.5
      H 6.0 0.0 2.5
      B 3.0 0.0 4.0
      O 2.2 1.0 4.5
      O 3.8 -1.0 4.5
      C 3.0 1.5 2.8
      H 1.5 1.0 5.2
      H 4.5 -1.0 5.2
      H 2.0 2.0 2.8
      H 4.0 2.0 2.8
      H 3.0 2.5 2.8
    &END COORD
    &KIND O
      POTENTIAL GTH-PBE-q6
      BASIS_SET DZVP-MOLOPT-GTH
    &END KIND
    &KIND C
      POTENTIAL GTH-PBE-q4
      BASIS_SET DZVP-MOLOPT-GTH
    &END KIND
    &KIND H
      POTENTIAL GTH-PBE-q1
      BASIS_SET DZVP-MOLOPT-GTH
    &END KIND
    &KIND B
      POTENTIAL GTH-PBE-q3
      BASIS_SET DZVP-MOLOPT-GTH
    &END KIND
    &KIND Ti
      POTENTIAL GTH-PBE-q12
      BASIS_SET DZVP-MOLOPT-SR-GTH
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
