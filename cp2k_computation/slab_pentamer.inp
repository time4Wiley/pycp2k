&GLOBAL
  PROJECT_NAME slab_pentamer
  RUN_TYPE GEO_OPT
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &SCF
      EPS_SCF 1e-06
      &OT
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 3 3 1
    &END KPOINTS
  &END DFT
  &SUBSYS
    &CELL
      A 15 0 0
      B 0 10 0
      C 0 0 25
    &END CELL
