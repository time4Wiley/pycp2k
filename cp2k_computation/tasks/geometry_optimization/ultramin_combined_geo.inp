&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME ultramin_combined_geo
  RUN_TYPE GEO_OPT
&END GLOBAL
&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    MAX_ITER 50
    MAX_FORCE 0.001
  &END GEO_OPT
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UCL
    &SCF
      MAX_SCF 20
      EPS_SCF 1e-05
      &OT
        MINIMIZER DIIS
        STEPSIZE 0.15
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &MGRID
      CUTOFF 200
      REL_CUTOFF 25
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 10.0 0 0
      B 0 10.0 0
      C 0 0 10.0
      PERIODIC NONE
    &END CELL
    &COORD
      Ti 0.0 0.0 0.0
      Ti 3.0 0.0 0.0
      Ti 6.0 0.0 0.0
      C 1.5 0.0 1.0
      C 4.5 0.0 1.0
      B 3.0 0.0 3.0
      O 2.0 0.0 3.5
      O 4.0 0.0 3.5
    &END COORD
    &KIND Ti
      POTENTIAL GTH-PBE-q12
      BASIS_SET SZV-MOLOPT-SR-GTH
    &END KIND
    &KIND O
      POTENTIAL GTH-PBE-q6
      BASIS_SET SZV-MOLOPT-GTH
    &END KIND
    &KIND B
      POTENTIAL GTH-PBE-q3
      BASIS_SET SZV-MOLOPT-SR-GTH
    &END KIND
    &KIND C
      POTENTIAL GTH-PBE-q4
      BASIS_SET SZV-MOLOPT-GTH
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
