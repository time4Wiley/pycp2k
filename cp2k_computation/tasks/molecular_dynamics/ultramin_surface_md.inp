&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME ultramin_surface_md
  RUN_TYPE MD
&END GLOBAL
&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 100
    TIMESTEP 0.5
    TEMPERATURE 300
  &END MD
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UCL
    &SCF
      MAX_SCF 20
      EPS_SCF 1e-05
      &OT
        MINIMIZER DIIS
        STEPSIZE 0.15
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &MGRID
      CUTOFF 200
      REL_CUTOFF 25
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 10.0 0 0
      B 0 10.0 0
      C 0 0 10.0
      PERIODIC NONE
    &END CELL
    &COORD
      Ti 0.0 0.0 0.0
      Ti 3.0 0.0 0.0
      Ti 6.0 0.0 0.0
      C 1.5 0.0 1.0
      C 4.5 0.0 1.0
    &END COORD
    &KIND Ti
      POTENTIAL GTH-PBE-q12
      BASIS_SET SZV-MOLOPT-SR-GTH
    &END KIND
    &KIND C
      POTENTIAL GTH-PBE-q4
      BASIS_SET SZV-MOLOPT-GTH
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
