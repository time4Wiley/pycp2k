&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME minimal_ti3c2_surface_equilib
  RUN_TYPE MD
&END GLOBAL
&MOTION
  &MD
    ENSEMBLE LANGEVIN
    STEPS 500
    TIMESTEP 1.0
    TEMPERATURE 300
    TEMP_TOL 100
    &LANGEVIN
      GAMMA 0.001
      NOISY_GAMMA 0.001
    &END LANGEVIN
    &THERMOSTAT
      TYPE CSVR
      &CSVR
        TIMECON 100.0
      &END CSVR
    &END THERMOSTAT
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 10
      &END EACH
    &END TRAJECTORY
    &VELOCITIES
      &EACH
        MD 10
      &END EACH
    &END VELOCITIES
    &FORCES
      &EACH
        MD 10
      &END EACH
    &END FORCES
    &RESTART
      &EACH
        MD 100
      &END EACH
    &END RESTART
  &END PRINT
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &SCF
      MAX_SCF 30
      EPS_SCF 5e-06
      SCF_GUESS PS
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &QS
      EXTRAPOLATION PS
      EXTRAPOLATION_ORDER 3
    &END QS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 40
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 12.0 0 0
      B 0 12.0 0
      C 0 0 12.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Ti 0.0 0.0 0.0
      Ti 3.0 0.0 0.0
      Ti 6.0 0.0 0.0
      C 1.5 0.0 -1.0
      C 4.5 0.0 -1.0
      O 0.0 0.0 1.5
      O 3.0 0.0 1.5
      O 6.0 0.0 1.5
      H 0.0 0.0 2.5
      H 3.0 0.0 2.5
      H 6.0 0.0 2.5
    &END COORD
    &KIND H
      POTENTIAL GTH-PBE-q1
      BASIS_SET DZVP-MOLOPT-GTH
    &END KIND
    &KIND C
      POTENTIAL GTH-PBE-q4
      BASIS_SET DZVP-MOLOPT-GTH
    &END KIND
    &KIND Ti
      POTENTIAL GTH-PBE-q12
      BASIS_SET DZVP-MOLOPT-SR-GTH
    &END KIND
    &KIND O
      POTENTIAL GTH-PBE-q6
      BASIS_SET DZVP-MOLOPT-GTH
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
