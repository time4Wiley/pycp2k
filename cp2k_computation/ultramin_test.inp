&GLOBAL
  PRINT_LEVEL LOW
  PROJECT_NAME ultramin_test
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &SCF
      MAX_SCF 15
      EPS_SCF 0.0001
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
    &END SCF
    &MGRID
      CUTOFF 150
      REL_CUTOFF 20
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 8.0 0 0
      B 0 8.0 0
      C 0 0 8.0
      PERIODIC NONE
    &END CELL
    &COORD
      B 0.0 0.0 0.0
      O -0.5 1.2 0.0
      O 1.0 -0.6 0.0
      O -0.5 -0.6 1.0
      H -1.4 1.3 0.0
      H 1.9 -0.7 0.0
      H -1.4 -0.7 1.0
    &END COORD
    &KIND B
      POTENTIAL GTH-PBE-q3
      BASIS_SET SZV-MOLOPT-GTH
    &END KIND
    &KIND O
      POTENTIAL GTH-PBE-q6
      BASIS_SET SZV-MOLOPT-GTH
    &END KIND
    &KIND H
      POTENTIAL GTH-PBE-q1
      BASIS_SET SZV-MOLOPT-GTH
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
