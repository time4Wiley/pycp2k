&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT_NAME h2o_single_point
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    MULTIPLICITY 1
    CHARGE 0
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &SCF
      MAX_SCF 300
      EPS_SCF 1e-06
      SCF_GUESS ATOMIC
      ADDED_MOS 500
      &DIAGONALIZATION ON
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING TRUE
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBUFFER 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 20.0 0.0 0.0
      B 0.0 20.0 0.0
      C 0.0 0.0 20.0
      PERIODIC NONE
    &END CELL
    &COORD
      O     0.000000     0.000000     0.000000
      H     0.757000     0.586000     0.000000
      H    -0.757000     0.586000     0.000000
    &END COORD
    &KIND O
      POTENTIAL GTH-PBE-q6
      BASIS_SET DZVP-MOLOPT-SR-GTH
    &END KIND
    &KIND H
      POTENTIAL GTH-PBE-q1
      BASIS_SET DZVP-MOLOPT-SR-GTH
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
&END FORCE_EVAL
